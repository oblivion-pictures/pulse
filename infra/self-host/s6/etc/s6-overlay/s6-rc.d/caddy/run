#!/bin/sh
# Caddy — reverse proxy + auto-TLS (Let's Encrypt).
# /etc/caddy/Caddyfile is rendered by cont-init (09-init-caddy.sh).
# Läuft wie jeder Dienst als pulse (gosu). Das Binden von 80/443 erlaubt dem
# Binary eine Datei-Fähigkeit (setcap cap_net_bind_service im Dockerfile) —
# Caddy steigt NICHT selbst ab: Der frühere Kommentar hier behauptete das
# Gegenteil, am laufenden Container widerlegt (2026-11-08, ps zeigte root).
# Zertifikats-Cache /data/caddy: gehört pulse — 01-init-data-dirs chown't
# /data bei JEDEM Start (auch der Upgrade-Pfad alter Volumes mit
# root-erzeugten Zertifikaten heilt so).
exec 2>&1
. /etc/pulse/env.sh
export XDG_DATA_HOME=/data/caddy
export XDG_CONFIG_HOME=/data/caddy
exec /usr/sbin/gosu pulse /usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
