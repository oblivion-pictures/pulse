#!/bin/sh
# Redis — embedded pub/sub + cache. Local-only bind. AOF persistence so
# a crash doesn't drop e.g. voice presence sets mid-session.
#
# `--save ""` wie die Cloud (infra/prod/docker-compose.yml, Commit fa9110e8e):
# keine RDB-Momentaufnahmen zusaetzlich zum AOF — jede kostet einen Fork und
# damit eine kurze Latenzspitze, die Haltbarkeit traegt das AOF. Hier stand
# bis 2026-10-14 `--save 60 1000`; derselbe Commit hatte die Cloud umgestellt
# und diese Datei uebersehen.
exec 2>&1
exec /usr/sbin/gosu pulse /usr/bin/redis-server \
  --bind 127.0.0.1 \
  --port 6379 \
  --dir /data/redis \
  --appendonly yes \
  --save "" \
  --maxmemory-policy noeviction \
  --loglevel notice
