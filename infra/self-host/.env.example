# Pulse Self-Host — Umgebungsvariablen
# Pflicht ist nur PULSE_HOSTNAME. Alles andere hat sichere Vorgaben.
#
# DIESE DATEI IST NUR EINE REFERENZ. Für den Start genügt eine .env mit einer
# einzigen Zeile (PULSE_HOSTNAME=…); diese Datei erklärt, was die übrigen
# Variablen bedeuten.

# ==========================================================================
# Pflicht
# ==========================================================================

# [PFLICHT] Die öffentliche Adresse deines Servers — braucht einen DNS-Eintrag
# auf diese Maschine. Caddy holt dafür das Let's-Encrypt-Zertifikat und nutzt
# den Namen als Site-Block-Header. Ohne sie startet der Container nicht.
# Beispiel: chat.firma.de
PULSE_HOSTNAME=chat.firma.de

# ==========================================================================
# Verbindung mit deinem Pulse-Konto
# ==========================================================================

# Nach dem ersten Start: docker exec -it pulse pulse-connect
# Das Werkzeug zeigt einen Link und einen Code; du bestätigst im Browser, und
# der Server holt seine Zugangsdaten selbst ab. Sie liegen danach im
# Datenvolumen (/data/pulse/verbindung.env), nicht in dieser Datei. Bis dahin
# startet der Server, nimmt aber niemanden auf.
#
# Die fünf mit [VERBINDUNG] markierten Werte unten sind das Gegenstück dazu.
# EIN NEUER SERVER LÄSST SIE LEER (so stehen sie hier): pulse-connect legt sie
# in verbindung.env ab. Nur BESTANDSSERVER (eingerichtet vor Oktober 2026, mit
# Freigabe) tragen sie hier ein — die .env aus der Freigabe-Zeit brachte sie
# fertig mit, und sie bleiben gültig. Stehen Instanz-ID, Owner oder die
# Zugangsdaten hier, weist pulse-connect den Server ab: es könnte nichts ändern.
# Ein hier gesetzter Wert gewinnt immer gegen verbindung.env, und genau
# deshalb darf hier kein Platzhalter stehen: er verdrängte die echten Werte,
# und pulse-connect bliebe wirkungslos. Eine LEERE Zeile (`NAME=`) zählt als
# nicht gesetzt.

# [VERBINDUNG] Snowflake-Instanz-ID (Beispiel: 1234567890). Leer = unverbunden:
# der Server startet, aber die Anmeldung (POST /session) antwortet 503
# nicht_verbunden, bis pulse-connect ihn verbunden hat. Bestandsserver tragen
# hier die Nummer aus der heruntergeladenen .env ein.
PULSE_INSTANCE_ID=

# [VERBINDUNG] Client-ID für das Cloud↔Instanz-Pairing (Beispiel:
# sh_live_xxxxxxxxxxxxxxxxxxxx). Gelesen wird sie zusammen mit dem Secret vom
# Direktpfad-Adapter (Heartbeat an die Cloud; ohne beide schläft er) und von
# chat-gateway/instance_name.py (meldet den Server-Namen an die Cloud).
PULSE_CLOUD_CLIENT_ID=

# [VERBINDUNG] Client-Secret zur Client-ID. In der heruntergeladenen .env frisch
# erzeugt; bei jedem neuen Download wird es rotiert (der alte Wert wird
# ungültig), ebenso bei jedem Lauf von pulse-connect.
PULSE_CLOUD_CLIENT_SECRET=

# [VERBINDUNG] Deine Cloud-User-ID (Owner, Beispiel: 1234567890). Der User mit
# dieser howispulse.com-Identität wird beim Anmelden automatisch Admin DIESER
# Instanz. Ohne den Wert hat die Instanz keinen Admin.
PULSE_INSTANCE_OWNER_ID=

# [VERBINDUNG, OPTIONAL] Mail-Adresse für Let's Encrypt (Warnungen vor
# Zertifikatsablauf) und Health-Probe-Notifications (DE 10c). Ohne sie läuft
# der Server genauso; beim Verbinden übernimmt er die Adresse deines Pulse-
# Kontos, falls die Cloud eine liefert. Beispiel: admin@firma.de
PULSE_ADMIN_EMAIL=

# ==========================================================================
# TLS
# ==========================================================================

# TLS-Modus.
# auto         (Default) — Caddy holt Let's Encrypt-Cert automatisch.
#              Voraussetzung: Port 80 + 443 erreichbar + DNS korrekt gesetzt.
# provided     — Eigenes Cert aus /data/certs/cert.pem + /data/certs/key.pem.
#                Für Hoster ohne Public-Reach (Tailscale Funnel, Cloudflare Tunnel,
#                internes Netz mit eigenem CA).
# behind-proxy — KEIN TLS im Container. Der interne Caddy macht nur HTTP-Routing
#                auf PULSE_HTTP_PORT (s.u.). TLS terminiert ein BEREITS vorhandener
#                Reverse-Proxy (Caddy/nginx/Traefik/Cloudflare-Tunnel) davor. Nutze
#                das, wenn 80/443 schon belegt sind (geteilter Host). Der Container
#                belegt dann KEINE 80/443 — du mappst nur PULSE_HTTP_PORT und legst
#                EINE Proxy-Regel an: pulse.domain → http://<container>:8080
#                (copy-paste examples in docs/self-host-guide.html).
PULSE_TLS_MODE=auto

# Nur bei PULSE_TLS_MODE=behind-proxy relevant: interner HTTP-Port, auf den dein
# externer Reverse-Proxy zeigt. Default 8080. Per `-p 127.0.0.1:8080:8080` mappen.
# PULSE_HTTP_PORT=8080

# ==========================================================================
# Steuerungs-Relay (App-Hosting — normalerweise setzt die Pulse-App das selbst)
# ==========================================================================

# Verbindet den Container per ausgehendem frpc-Tunnel mit dem Pulse-Cloud-Relay,
# damit er OHNE öffentliche IP/Port-Forwarding unter der Relay-Subdomain
# erreichbar ist. Alle drei Werte kommen aus dem Bootstrap-Redeem (Pairing);
# VPS-Setups lassen sie weg — der Tunnel-Dienst bleibt dann inaktiv.
# Erfordert PULSE_TLS_MODE=behind-proxy (der Relay terminiert TLS).
# PULSE_RELAY_SUBDOMAIN=brave-otter-4f2a.relay.howispulse.com
# PULSE_RELAY_SERVER_ADDR=howispulse.com:7000
# PULSE_RELAY_TUNNEL_TOKEN=plse_relay_...   # Secret — nie committen/loggen
# Explizite Host-Herkunft (Vorrang vor der Token-Heuristik; die Server-App
# setzt app_host, ein VPS-Setup vps). Fehlt die Env, gilt für Bestands-
# Container weiter: Relay-Token gesetzt = App-Hosting.
# PULSE_HOST_ORIGIN=app_host

# ==========================================================================
# Voice-NAT / TURN
# ==========================================================================

# Öffentliche IP des Servers — wird NUR von coturn gelesen (external-ip, für
# den TURN-Relay-Pfad von Voice). Ohne gesetzten Wert ermittelt coturn sie
# selbst über https://api.ipify.org. Setze sie nur, wenn diese Auto-Erkennung
# scheitert (z.B. kein ausgehendes HTTPS zu api.ipify.org, mehrere IPs am Host).
#
# LiveKit liest diese Variable NICHT — es ermittelt seine öffentliche IP immer
# selbst per STUN (use_external_ip in livekit.yaml.template), unabhängig
# davon, ob PULSE_PUBLIC_IP gesetzt ist.
# PULSE_PUBLIC_IP=203.0.113.7

# coturn deaktivieren (nur wenn du einen eigenen TURN-Server betreibst).
# Default: false (coturn läuft im Container für NAT-Traversal).
# PULSE_TURN_DISABLED=false

# ==========================================================================
# Datenhaltung
# ==========================================================================

# Pfad des persistenten Data-Volumes im Container.
# Nur ändern wenn du das Volume explizit woanders mountest.
# Default: /data
# PULSE_DATA_PATH=/data

# ==========================================================================
# Logging
# ==========================================================================

# Log-Level für alle Sub-Services.
# Werte: critical | error | warning | info | debug
# Default: info (setzt der Container selbst, auch ohne Eintrag hier)
#
# Bis zum 2026-08-25 las diesen Schalter NIEMAND — er stand in der Umgebung
# und bewirkte nichts. Jetzt wirkt er, und damit auch seine Kehrseite: auf
# `info` steht im Protokoll, wem diese Instanz laut Konfiguration gehört, und
# bei jeder Anmeldung, ob der Anmeldende dieses Konto ist. Wer hier `warning`
# einträgt, schaltet die Antwort auf „warum bin ich kein Admin?" ab.
# PULSE_LOG_LEVEL=info

# ==========================================================================
# Backup
# ==========================================================================

# Der `backup`-Service macht periodische pg_dump-Snapshots nach /data/backups
# (im Admin-Panel unter "Backups" sichtbar).

# Intervall zwischen Snapshots in Sekunden. Default: 86400 (täglich).
# PULSE_BACKUP_INTERVAL_SECONDS=86400

# Wie viele Snapshots behalten (ältere werden gelöscht). Default: 7.
# PULSE_BACKUP_RETENTION=7

# Backup komplett deaktivieren — nur für externe Backup-Lösungen empfohlen.
# WARNUNG: Kein Backup = Datenverlust bei Disk-Failure. Nicht empfohlen.
# PULSE_BACKUP_DISABLED=false

# ==========================================================================
# Automatisch gesetzt im Single-Container (nicht überschreiben)
# ==========================================================================

# PULSE_CLOUD_ORIGIN=https://howispulse.com
# PULSE_INSTANCE_MODE=self-host
