+// tonOriginal ist ein Opus-Paket, wie es der Sender vor dem Packen hatte.
+type tonOriginal struct {
+	seq  uint16
+	ts   uint32
+	nutz []byte
+}
+
+func neuesOriginal(seq uint16, ts uint32) tonOriginal {
+	return tonOriginal{seq: seq, ts: ts, nutz: []byte{byte(seq >> 8), byte(seq), 0xAB}}
+}
+
+// redPaket packt wie `streaming/pulse-whip/src/red.rs`: Koepfe der Kopien
+// (aeltester zuerst), Primaerkopf, dann die Daten in derselben Reihenfolge.
+func redPaket(prim tonOriginal, kopien ...tonOriginal) *rtp.Packet {
+	var nutz []byte
+	for _, k := range kopien {
+		wort := (prim.ts-k.ts)<<10 | uint32(len(k.nutz))
+		var b [4]byte
+		binary.BigEndian.PutUint32(b[:], wort)
+		nutz = append(nutz, 0x80|111)
+		nutz = append(nutz, b[1:]...)
+	}
+	nutz = append(nutz, 111)
+	for _, k := range kopien {
+		nutz = append(nutz, k.nutz...)
+	}
+	nutz = append(nutz, prim.nutz...)
+	return &rtp.Packet{
+		Header: rtp.Header{
+			Version: 2, Marker: true, PayloadType: 63,
+			SequenceNumber: prim.seq, Timestamp: prim.ts, SSRC: 0x1234,
+		},
+		Payload: nutz,
+	}
+}
+
+// Ein Strom 100..115 mit je zwei Kopien, durch Reserve UND den echten
+// gortsplib-Empfaenger (Fenster 4, wie mit PULSE_AUDIO_REORDER_BUFFER=4).
+func stromMitVerlust(t *testing.T, verloren ...uint16) ([]*rtp.Packet, uint64, *tonReserve) {
+	t.Helper()
+	r := &tonReserve{redPT: 63}
+	rr := newAudioReceiver(t, 4)
+
+	weg := map[uint16]bool{}
+	for _, s := range verloren {
+		weg[s] = true
+	}
+	var orig []tonOriginal
+	var aus []*rtp.Packet
+	var lostSumme uint64
+	for seq := uint16(100); seq <= 115; seq++ {
+		o := neuesOriginal(seq, uint32(seq)*480)
+		var kopien []tonOriginal
+		if len(orig) >= 2 {
+			kopien = orig[len(orig)-2:]
+		} else {
+			kopien = orig
+		}
+		pkt := redPaket(o, kopien...)
+		orig = append(orig, o)
+		if weg[seq] {
+			continue
+		}
+		for _, p := range r.auspacken(pkt) {
+			out, lost := rr.ProcessPacket2(p, time.Now(), true)
+			lostSumme += lost
+			aus = append(aus, out...)
+		}
+	}
+	return aus, lostSumme, r
+}
+
+func seqs(pakete []*rtp.Packet) []uint16 {
+	var s []uint16
+	for _, p := range pakete {
+		s = append(s, p.SequenceNumber)
+	}
+	return s
+}
+
+func seqBereich(von, bis uint16, ohne ...uint16) []uint16 {
+	var s []uint16
+naechste:
+	for x := von; x <= bis; x++ {
+		for _, o := range ohne {
+			if x == o {
+				continue naechste
+			}
+		}
+		s = append(s, x)
+	}
+	return s
+}
