+func TestPulseTonReserveBericht(t *testing.T) {
+	r := &tonReserve{redPT: 63}
+	r.ersetzt.Store(5)
+	r.unrettbarDazu(2)
+	require.Equal(t, "[pulse] Ton-Reserve: fehlten 7, ersetzt 5, unrettbar 2", r.bericht())
