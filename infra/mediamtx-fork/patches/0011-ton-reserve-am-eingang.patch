diff --git a/internal/protocols/webrtc/ton_reserve.go b/internal/protocols/webrtc/ton_reserve.go
new file mode 100644
index 0000000..f679e7e
--- /dev/null
+++ b/internal/protocols/webrtc/ton_reserve.go
@@ -0,0 +1,294 @@
+package webrtc
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/pion/rtp"
+	"github.com/pion/webrtc/v4"
+
+	"github.com/bluenviron/mediamtx/internal/logger"
+)
+
+// Ton-Reserve am Eingang (Pulse, Patch 0011): RED (RFC 2198) fuer Opus auf
+// der Strecke Sender -> Server.
+//
+// Warum es das braucht: unsere Sender melden fuer Opus kein NACK an, ein
+// verlorenes Tonpaket kommt am Eingang also nie nach (Patch 0008/0009). Mit
+// RED traegt jedes Paket die letzten Pakete noch einmal mit; fehlt eins, steckt
+// es im naechsten. Die Sender (`streaming/pulse-whip/src/red.rs` im
+// Pulse-Repo) bieten `audio/red` VOR Opus an und packen nur, wenn die Antwort
+// es enthaelt.
+//
+// Was sich aendert, aus dem Code gefolgert:
+//
+//   - Nur am EINGANG (WHIP, `Publish: false`) und nur mit PULSE_AUDIO_RED=1.
+//     Ohne Schalter wird RED nicht angemeldet, also nie ausgehandelt, und
+//     keine Spur bekommt eine Reserve: alles bleibt wie Upstream.
+//   - Ausgepackt wird VOR dem Umordnungspuffer. Dahinter sieht alles nur
+//     Opus: `Codec()` meldet den Opus-Eintrag unter RED, `to_stream.go` baut
+//     daraus ein schlichtes `format.Opus`, und die Zuschauer bekommen nie RED.
+//   - Keine zusaetzliche Wartezeit: eine Kopie geht in dem Moment hinaus, in
+//     dem ihr Traeger eintrifft. Faellt der Traeger mit aus, entscheidet der
+//     Umordnungspuffer aus 0008 wie bisher.
+//   - Schon Durchgelassenes geht nicht noch einmal hinein, sonst saehe der
+//     Empfaenger jede Nummer bis zu dreimal. gortsplib (`pkg/rtpreceiver`,
+//     v5.6.0, `reorder`) verwirft solche Doppel zwar, zaehlt sie aber auf
+//     seine Ruecksetz-Schwelle (mehr als ein Puffer voll in Folge); erst ein
+//     neues Paket setzt die Zaehlung zurueck — bei 3 Kopien und
+//     4 Plaetzen (0008) bliebe ein Platz Abstand. Und `ersetzt` zaehlt so nur,
+//     was bis dahin fehlte.
+const mimeTypeRed = "audio/red"
+
+// tonReserveFenster ist die Laenge des Gedaechtnisses fuer durchgelassene
+// Sequenznummern. Eine Kopie liegt hoechstens so viele Pakete hinter ihrem
+// Traeger, wie er Kopien traegt (Sender: 0-3); 64 reicht weit darueber hinaus
+// und passt in ein uint64.
+const tonReserveFenster = 64
+
+func pulseAudioRed() bool {
+	return os.Getenv("PULSE_AUDIO_RED") == "1"
+}
+
+// pulseTonReserveAnmelden meldet RED fuer den Ton an. Die fmtp-Zeile muss
+// nicht der des Angebots gleichen (`111/111/111` bei zwei Kopien): pion
+// vergleicht bei fremden Codecs ersatzweise nur Art, Takt und Kanaele
+// (`codecParametersFuzzySearch`, webrtc/v4 rtpcodec.go), und die Antwort
+// traegt die Zeile des Angebots (`TestPulseTonReserveAushandlung`).
+func pulseTonReserveAnmelden(mediaEngine *webrtc.MediaEngine) error {
+	if !pulseAudioRed() {
+		return nil
+	}
+	return mediaEngine.RegisterCodec(webrtc.RTPCodecParameters{
+		RTPCodecCapability: webrtc.RTPCodecCapability{
+			MimeType:    mimeTypeRed,
+			ClockRate:   48000,
+			Channels:    2,
+			SDPFmtpLine: "111/111",
+		},
+		PayloadType: 63,
+	}, webrtc.RTPCodecTypeAudio)
+}
+
+// pulseOpusUnterRed liefert den ausgehandelten Opus-Eintrag, auf den der
+// RED-Eintrag zeigt (erste Nummer seiner fmtp-Zeile; ist sie unlesbar, der
+// erste Opus-Eintrag). Ohne RED in den Parametern: false.
+func pulseOpusUnterRed(params webrtc.RTPParameters) (webrtc.RTPCodecParameters, bool) {
+	for _, red := range params.Codecs {
+		if !strings.EqualFold(red.MimeType, mimeTypeRed) {
+			continue
+		}
+		erste, _, _ := strings.Cut(red.SDPFmtpLine, "/")
+		pt, err := strconv.ParseUint(strings.TrimSpace(erste), 10, 8)
+		for _, c := range params.Codecs {
+			if strings.EqualFold(c.MimeType, webrtc.MimeTypeOpus) &&
+				(err != nil || c.PayloadType == webrtc.PayloadType(pt)) {
+				return c, true
+			}
+		}
+	}
+	return webrtc.RTPCodecParameters{}, false
+}
+
+type reserveStand struct {
+	ersetzt, unrettbar, kaputt uint64
+}
+
+// tonReserve packt die RED-Pakete EINER Spur aus. `auspacken` laeuft nur im
+// Lesefaden; die Zaehler liest auch `close()`, deshalb atomar.
+type tonReserve struct {
+	redPT uint8
+	opus  webrtc.RTPCodecParameters
+
+	begonnen bool
+	hoechste uint16
+	gesehen  uint64 // Bit i: hoechste-i ging schon hinaus
+
+	ersetzt   atomic.Uint64 // aus einer Kopie eingesetzt
+	unrettbar atomic.Uint64 // vom Empfaenger als verloren gemeldet
+	kaputt    atomic.Uint64 // RED-Pakete, die sich nicht zerlegen liessen
+
+	meldeMutex    sync.Mutex
+	letzteMeldung time.Time
+	gemeldet      reserveStand
+}
+
+// neu sagt, ob seq noch nicht hinausging, und merkt es sich. Ein
+// Primaerblock hinter dem Fenster geht trotzdem durch, ungemerkt: ob er zu
+// spaet ist, entscheidet der Empfaenger wie Upstream — so faengt sich der Ton
+// auch, falls ein Sender auf derselben SSRC zurueck-nummeriert (keiner unserer
+// Sender tut das). Die Reserve wirkt dann erst wieder, wenn die Nummern das
+// alte Fenster ueberholt haben; eine Kopie dahinter bleibt draussen.
+func (r *tonReserve) neu(seq uint16, kopie bool) bool {
+	if !r.begonnen {
+		r.begonnen, r.hoechste, r.gesehen = true, seq, 1
+		return true
+	}
+	d := int(int16(seq - r.hoechste)) // mit Umbruch
+	if d > 0 {
+		if d >= tonReserveFenster {
+			r.gesehen = 0
+		} else {
+			r.gesehen <<= uint(d)
+		}
+		r.gesehen |= 1
+		r.hoechste = seq
+		return true
+	}
+	if -d >= tonReserveFenster {
+		return !kopie
+	}
+	bit := uint64(1) << uint(-d)
+	if r.gesehen&bit != 0 {
+		return false
+	}
+	r.gesehen |= bit
+	return true
+}
+
+type redBlock struct {
+	pt      uint8
+	abstand uint32
+	laenge  int
+}
+
+// auspacken macht aus einem RED-Paket die Opus-Pakete, die noch nicht
+// hinausgingen: erst die Kopien (aeltester zuerst, Sequenz `seq - k` aus der
+// Position, Zeitstempel `ts - abstand`), dann den Primaerblock mit dem Kopf
+// des RED-Pakets. Kopien bekommen weder Marker noch Header-Erweiterungen: die
+// gehoeren zum Sendezeitpunkt des Traegers. Ein Paket mit anderer PT geht
+// unveraendert durch; ohne Reserve (nil) ebenso.
+func (r *tonReserve) auspacken(pkt *rtp.Packet) []*rtp.Packet {
+	if r == nil {
+		return []*rtp.Packet{pkt}
+	}
+	if pkt.PayloadType != r.redPT {
+		if !r.neu(pkt.SequenceNumber, false) {
+			return nil
+		}
+		return []*rtp.Packet{pkt}
+	}
+
+	bloecke, primPT, pos, ok := redKoepfe(pkt.Payload)
+	if !ok {
+		r.kaputt.Add(1)
+		return nil
+	}
+
+	aus := make([]*rtp.Packet, 0, len(bloecke)+1)
+	for i, b := range bloecke {
+		daten := pkt.Payload[pos : pos+b.laenge : pos+b.laenge]
+		pos += b.laenge
+		seq := pkt.SequenceNumber - uint16(len(bloecke)-i)
+		if !r.neu(seq, true) {
+			continue
+		}
+		r.ersetzt.Add(1)
+		aus = append(aus, &rtp.Packet{
+			Header: rtp.Header{
+				Version:        2,
+				PayloadType:    b.pt,
+				SequenceNumber: seq,
+				Timestamp:      pkt.Timestamp - b.abstand,
+				SSRC:           pkt.SSRC,
+				CSRC:           pkt.CSRC,
+			},
+			Payload: daten,
+		})
+	}
+
+	if r.neu(pkt.SequenceNumber, false) {
+		prim := &rtp.Packet{Header: pkt.Header, Payload: pkt.Payload[pos:len(pkt.Payload):len(pkt.Payload)]}
+		prim.PayloadType = primPT
+		prim.Padding, prim.Header.PaddingSize = false, 0
+		aus = append(aus, prim)
+	}
+	return aus
+}
+
+// redKoepfe liest die Blockkoepfe (RFC 2198 Abschnitt 3: F=1 mit 4 Byte —
+// PT, 14 bit Zeitstempel-Abstand, 10 bit Laenge —, zuletzt F=0 mit 1 Byte)
+// und prueft, dass alle Bloecke ins Paket passen. pos zeigt auf die Daten.
+func redKoepfe(nutz []byte) (bloecke []redBlock, primPT uint8, pos int, ok bool) {
+	for {
+		if pos >= len(nutz) {
+			return nil, 0, 0, false
+		}
+		if nutz[pos]&0x80 == 0 {
+			primPT = nutz[pos] & 0x7f
+			pos++
+			break
+		}
+		if pos+4 > len(nutz) {
+			return nil, 0, 0, false
+		}
+		wort := uint32(nutz[pos+1])<<16 | uint32(nutz[pos+2])<<8 | uint32(nutz[pos+3])
+		bloecke = append(bloecke, redBlock{
+			pt:      nutz[pos] & 0x7f,
+			abstand: wort >> 10,
+			laenge:  int(wort & 0x3ff),
+		})
+		pos += 4
+	}
+	rest := len(nutz) - pos
+	for _, b := range bloecke {
+		rest -= b.laenge
+	}
+	if rest < 0 {
+		return nil, 0, 0, false
+	}
+	return bloecke, primPT, pos, true
+}
+
+// unrettbarDazu zaehlt, was der Empfaenger hinter der Reserve noch als
+// verloren meldet.
+func (r *tonReserve) unrettbarDazu(lost uint64) {
+	if r != nil && lost != 0 {
+		r.unrettbar.Add(lost)
+	}
+}
+
+func (r *tonReserve) stand() reserveStand {
+	return reserveStand{r.ersetzt.Load(), r.unrettbar.Load(), r.kaputt.Load()}
+}
+
+func (r *tonReserve) bericht() string {
+	s := r.stand()
+	text := fmt.Sprintf("[pulse] Ton-Reserve: fehlten %d, ersetzt %d, unrettbar %d",
+		s.ersetzt+s.unrettbar, s.ersetzt, s.unrettbar)
+	if s.kaputt > 0 {
+		text += fmt.Sprintf(", kaputt %d", s.kaputt)
+	}
+	return text
+}
+
+// vielleichtMelden schreibt den Stand ins Log, wenn er sich geaendert hat —
+// hoechstens einmal je Minute.
+func (r *tonReserve) vielleichtMelden(log logger.Writer) {
+	if r == nil {
+		return
+	}
+	r.meldeMutex.Lock()
+	defer r.meldeMutex.Unlock()
+	jetzt := time.Now()
+	if s := r.stand(); s != r.gemeldet &&
+		(r.letzteMeldung.IsZero() || jetzt.Sub(r.letzteMeldung) >= time.Minute) {
+		r.gemeldet, r.letzteMeldung = s, jetzt
+		log.Log(logger.Info, "%s", r.bericht())
+	}
+}
+
+// melden schreibt den Endstand (beim Schliessen der Spur), auch unveraendert.
+func (r *tonReserve) melden(log logger.Writer) {
+	if r == nil {
+		return
+	}
+	r.meldeMutex.Lock()
+	defer r.meldeMutex.Unlock()
+	log.Log(logger.Info, "%s", r.bericht())
+}
