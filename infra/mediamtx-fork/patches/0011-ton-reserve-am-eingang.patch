+
+// Ende zu Ende ueber pion: ein Sender schickt RED (63) mit je zwei Kopien und
+// verliert zwei Pakete am Stueck; hinter dem Eingang kommt schlichtes Opus an,
+// lueckenlos, und `ToStream` sieht eine zweikanalige Opus-Spur.
+//
+// Absichtlich NICHT unter dem Namensfilter von `bauen.sh` (`Pulse|Bildmarke`),
+// aus demselben Grund wie `TestTonNachforderungRichtungZuschauer`: echte
+// Verbindung ueber Loopback. Er laeuft im Bild-Bau, der das ganze Paket prueft.
+func TestTonReserveEndeZuEnde(t *testing.T) {
+	t.Setenv("PULSE_AUDIO_RED", "1")
+
+	redCaps := webrtc.RTPCodecCapability{
+		MimeType: "audio/red", ClockRate: 48000, Channels: 2, SDPFmtpLine: "111/111/111",
+	}
+	me := &webrtc.MediaEngine{}
+	require.NoError(t, me.RegisterCodec(webrtc.RTPCodecParameters{
+		RTPCodecCapability: redCaps, PayloadType: 63,
+	}, webrtc.RTPCodecTypeAudio))
+	require.NoError(t, me.RegisterCodec(webrtc.RTPCodecParameters{
+		RTPCodecCapability: webrtc.RTPCodecCapability{
+			MimeType: webrtc.MimeTypeOpus, ClockRate: 48000, Channels: 2,
+			SDPFmtpLine: "minptime=10;useinbandfec=1;stereo=1;sprop-stereo=1",
+		},
+		PayloadType: 111,
+	}, webrtc.RTPCodecTypeAudio))
+	sender, err := webrtc.NewAPI(webrtc.WithMediaEngine(me)).NewPeerConnection(webrtc.Configuration{})
+	require.NoError(t, err)
+	defer sender.Close() //nolint:errcheck
+
+	track, err := webrtc.NewTrackLocalStaticRTP(redCaps, "audio", "publisher")
+	require.NoError(t, err)
+	_, err = sender.AddTrack(track)
+	require.NoError(t, err)
+
+	offer, err := sender.CreateOffer(nil)
+	require.NoError(t, err)
+	gesammelt := webrtc.GatheringCompletePromise(sender)
+	require.NoError(t, sender.SetLocalDescription(offer))
+	<-gesammelt
+
+	server := &PeerConnection{
+		LocalRandomUDP:    true,
+		IPsFromInterfaces: true,
+		Publish:           false,
+		Log:               test.NilLogger,
+	}
+	require.NoError(t, server.Start())
+	defer server.Close()
+
+	answer, err := server.CreateFullAnswer(sender.LocalDescription(), false)
+	require.NoError(t, err)
+	require.NoError(t, sender.SetRemoteDescription(*answer))
+	require.NoError(t, server.WaitUntilConnected(10*time.Second))
+
+	var orig []tonOriginal
+	senden := func(seq uint16, weg bool) {
+		o := neuesOriginal(seq, uint32(seq)*480)
+		kopien := orig
+		if len(kopien) > 2 {
+			kopien = kopien[len(kopien)-2:]
+		}
+		pkt := redPaket(o, kopien...)
+		orig = append(orig, o)
+		if !weg {
+			require.NoError(t, track.WriteRTP(pkt))
+		}
+	}
+
+	// Das erste Paket loest OnTrack aus.
+	senden(100, false)
+	require.NoError(t, server.GatherInboundTracks(5*time.Second))
+	tr := server.InboundTracks()[0]
+	require.NotNil(t, tr.reserve, "RED-Spur ohne Reserve")
+	require.Equal(t, webrtc.MimeTypeOpus, tr.Codec().MimeType)
+
+	var subStream *stream.SubStream
+	medias, err := ToStream(server, &conf.Path{}, &subStream, nil)
+	require.NoError(t, err)
+	require.Equal(t, &format.Opus{PayloadTyp: 96, ChannelCount: 2}, medias[0].Formats[0])
+
+	ankunft := make(chan *rtp.Packet, 64)
+	tr.OnPacketRTP = func(p *rtp.Packet) { ankunft <- p }
+	server.StartReading()
+
+	for seq := uint16(101); seq <= 108; seq++ {
+		senden(seq, seq == 104 || seq == 105)
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	var got []uint16
+	for len(got) < 9 {
+		select {
+		case p := <-ankunft:
+			o := neuesOriginal(p.SequenceNumber, uint32(p.SequenceNumber)*480)
+			require.Equal(t, o.nutz, p.Payload, "Nutzlast von %d", p.SequenceNumber)
+			require.Equal(t, o.ts, p.Timestamp)
+			got = append(got, p.SequenceNumber)
+		case <-time.After(5 * time.Second):
+			t.Fatalf("nur %v kam an", got)
+		}
+	}
+	require.Equal(t, seqBereich(100, 108), got)
+	require.Equal(t, uint64(2), tr.reserve.ersetzt.Load())
+}
