+func TestPulseTonReserveEinzelDoppelDreifach(t *testing.T) {
+	for _, ca := range []struct {
+		name     string
+		verloren []uint16
+		fehlt    []uint16
+		ersetzt  uint64
+	}{
+		{"einzeln", []uint16{104}, nil, 1},
+		{"doppelt", []uint16{104, 105}, nil, 2},
+		{"dreifach", []uint16{104, 105, 106}, []uint16{104}, 2},
+	} {
+		t.Run(ca.name, func(t *testing.T) {
+			aus, lost, r := stromMitVerlust(t, ca.verloren...)
+			require.Equal(t, seqBereich(100, 115, ca.fehlt...), seqs(aus))
+			require.Equal(t, uint64(len(ca.fehlt)), lost, "was die Reserve nicht hat, meldet der Empfaenger")
+			require.Equal(t, ca.ersetzt, r.ersetzt.Load())
+			require.Zero(t, r.kaputt.Load())
+
+			// Jedes herausgegebene Paket ist das Original: Opus-PT, Nummer,
+			// Zeitstempel, Nutzlast.
+			for _, p := range aus {
+				o := neuesOriginal(p.SequenceNumber, uint32(p.SequenceNumber)*480)
+				require.Equal(t, uint8(111), p.PayloadType)
+				require.Equal(t, o.ts, p.Timestamp, "Zeitstempel von %d", p.SequenceNumber)
+				require.Equal(t, o.nutz, p.Payload, "Nutzlast von %d", p.SequenceNumber)
+				require.Equal(t, uint32(0x1234), p.SSRC)
+			}
+		})
+	}
+}
+
+// Kopien tragen weder Marker noch Header-Erweiterungen des RED-Pakets (die
+// gehoeren zu dessen Sendezeitpunkt), der Primaerblock behaelt beides.
+func TestPulseTonReserveKopfDerKopien(t *testing.T) {
+	r := &tonReserve{redPT: 63}
+	require.Len(t, r.auspacken(redPaket(neuesOriginal(10, 4800))), 1)
+
+	pkt := redPaket(neuesOriginal(12, 5760), neuesOriginal(11, 5280))
+	require.NoError(t, pkt.SetExtension(3, []byte{0x42}))
+	aus := r.auspacken(pkt)
+	require.Len(t, aus, 2)
+
+	kopie, prim := aus[0], aus[1]
+	require.Equal(t, uint16(11), kopie.SequenceNumber)
+	require.False(t, kopie.Marker)
+	require.False(t, kopie.Extension)
+	require.Empty(t, kopie.Extensions)
+
+	require.Equal(t, uint16(12), prim.SequenceNumber)
+	require.True(t, prim.Marker)
+	require.Equal(t, []byte{0x42}, prim.GetExtension(3))
+	require.Equal(t, uint8(111), prim.PayloadType)
+}
+
+// Paket n wird aus n+1 ersetzt; trifft das Original n danach doch noch ein
+// (vertauscht statt verloren), geht es kein zweites Mal hinaus.
+func TestPulseTonReserveKeineDoppelung(t *testing.T) {
+	r := &tonReserve{redPT: 63}
+	o := func(s uint16) tonOriginal { return neuesOriginal(s, uint32(s)*480) }
+
+	require.Equal(t, []uint16{1}, seqs(r.auspacken(redPaket(o(1)))))
+	require.Equal(t, []uint16{2, 3}, seqs(r.auspacken(redPaket(o(3), o(1), o(2)))))
+	require.Empty(t, r.auspacken(redPaket(o(2), o(1))), "Original 2 nach seiner Kopie")
+	require.Equal(t, []uint16{4}, seqs(r.auspacken(redPaket(o(4), o(2), o(3)))))
+	require.Empty(t, r.auspacken(redPaket(o(4), o(2), o(3))), "doppelt geliefertes Paket")
+	require.Equal(t, uint64(1), r.ersetzt.Load())
+}
+
+// Ueber den Umbruch der Sequenznummer: 65535 fehlt und kommt aus Paket 0, mit
+// dem Zeitstempel aus dessen Abstand.
+func TestPulseTonReserveUmbruch(t *testing.T) {
+	r := &tonReserve{redPT: 63}
+	a := neuesOriginal(65534, 1_000_000)
+	b := neuesOriginal(65535, 1_000_480)
+	c := neuesOriginal(0, 1_000_960)
+
+	require.Equal(t, []uint16{65534}, seqs(r.auspacken(redPaket(a))))
+	aus := r.auspacken(redPaket(c, a, b))
+	require.Equal(t, []uint16{65535, 0}, seqs(aus))
+	require.Equal(t, c.ts-480, aus[0].Timestamp)
+	require.Equal(t, b.nutz, aus[0].Payload)
+	require.Equal(t, uint64(1), r.ersetzt.Load())
+}
+
+// Liegt ein Primaerpaket weiter zurueck als das Fenster, geht es trotzdem
+// weiter — ob es zu spaet ist, entscheidet der Empfaenger wie Upstream (er
+// faengt sich nach einem Neu-Nummerieren des Senders selbst). Eine so alte
+// KOPIE dagegen bleibt draussen.
+func TestPulseTonReserveSprungZurueck(t *testing.T) {
+	r := &tonReserve{redPT: 63}
+	require.Len(t, r.auspacken(redPaket(neuesOriginal(5000, 48000))), 1)
+
+	weit := neuesOriginal(5000-70, 48000-70*480)
+	require.Equal(t, []uint16{5001}, seqs(r.auspacken(redPaket(neuesOriginal(5001, 48480), weit))),
+		"Kopie hinter dem Fenster")
+
+	alt := redPaket(neuesOriginal(100, 960), neuesOriginal(99, 480))
+	require.Equal(t, []uint16{100}, seqs(r.auspacken(alt)), "Primaerblock hinter dem Fenster")
+	require.Zero(t, r.ersetzt.Load())
+}
+
+// Ein Paket mit anderer PT (der Sender schaltet auf schlichtes Opus) geht
+// unveraendert durch.
+func TestPulseTonReserveOhneRedDurch(t *testing.T) {
+	r := &tonReserve{redPT: 63}
+	pkt := &rtp.Packet{
+		Header:  rtp.Header{Version: 2, PayloadType: 111, SequenceNumber: 7, Timestamp: 3360},
+		Payload: []byte{0x80 | 111, 1, 2, 3},
+	}
+	aus := r.auspacken(pkt)
+	require.Len(t, aus, 1)
+	require.Same(t, pkt, aus[0])
+
+	// Ohne Reserve (Spur ohne RED, Schalter aus) ebenso — auch mit PT 63.
+	var ohne *tonReserve
+	red := redPaket(neuesOriginal(8, 3840), neuesOriginal(7, 3360))
+	aus = ohne.auspacken(red)
+	require.Len(t, aus, 1)
+	require.Same(t, red, aus[0])
+	ohne.vielleichtMelden(test.NilLogger)
+	ohne.melden(test.NilLogger)
+}
+
+func TestPulseTonReserveKaputt(t *testing.T) {
+	r := &tonReserve{redPT: 63}
+	for _, nutz := range [][]byte{
+		{},                                     // leer
+		{0x80 | 111, 0, 0},                     // Blockkopf abgeschnitten
+		{0x80 | 111, 0, 0x07, 0x80, 111, 1, 2}, // Block 0x380 = 896 Byte, Paket viel kuerzer
+	} {
+		aus := r.auspacken(&rtp.Packet{
+			Header:  rtp.Header{Version: 2, PayloadType: 63, SequenceNumber: 1, Timestamp: 480},
+			Payload: nutz,
+		})
+		require.Nil(t, aus)
+	}
+	require.Equal(t, uint64(3), r.kaputt.Load())
+
+	// Danach geht es normal weiter, die Nummer 1 ist nicht verbraucht.
+	require.Equal(t, []uint16{1}, seqs(r.auspacken(redPaket(neuesOriginal(1, 480)))))
+}
