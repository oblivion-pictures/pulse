+		// (GHSA-7498-vjgw-9cr2; upstream fix in gortmplib PR #121, v1.0.2).
+		if entry.NaluType == byte(typ) && entry.NumNalus == 1 && len(entry.Nalus) == 1 &&
+			len(entry.Nalus[0].NALUnit) > 0 &&
 			h265.NALUType((entry.Nalus[0].NALUnit[0]>>1)&0b111111) == typ {
