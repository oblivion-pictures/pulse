# Pulse-Fork von LiveKit — die EINZIGE Quelle für Fassung, Commits und
# Patch-Stand. Gelesen von `bauen.sh` (Linux-Image und Windows-Server-App
# bauen beide über dieses Skript) und von `desktop/scripts/fetch-win-native.ps1`
# (Stempel-Vergleich gegen eine zwischengespeicherte livekit-server.exe).
#
# Nur schlichte KEY=WERT-Zeilen, ohne Anführungszeichen und ohne
# Shell-Ausdrücke: PowerShell liest die Datei per Muster, nicht per Shell.

# LiveKit-Fassung. Steht unverändert im Binary (`livekit-server --version`),
# `bauen.sh` prüft sie gegen `version/version.go` des geholten Stands.
LIVEKIT_VERSION=1.13.3
# Commit, auf den der Tag v1.13.3 zeigt (git ls-remote, 2026-10-12). Geholt wird
# per Commit, nicht per Tag — ein Tag lässt sich umhängen.
LIVEKIT_COMMIT=8f6a9cb8b735549f0c5770df8ea70ac51f860ecb
# mediatransportutil — genau der Stand, den LiveKit v1.13.3 in seiner go.mod
# verlangt (v0.0.0-20260608063931-a3417d38cda0). `bauen.sh` bricht ab, wenn
# go.mod einen anderen nennt: dann wäre der Patch gegen einen Stand gebaut,
# den LiveKit gar nicht benutzt.
MTU_COMMIT=a3417d38cda0c840ef8c7ebe9628472028921d58
# Unser Patch-Stand. Hochzählen, sobald sich der Inhalt von patches/ ändert —
# nicht bei einem LiveKit-Update (das bewegt LIVEKIT_VERSION). Der Stempel
# `<LIVEKIT_VERSION>-pulse<PULSE_REVISION>` liegt neben jedem gebauten Binary
# und verrät einer zwischengespeicherten Kopie, dass sie veraltet ist.
PULSE_REVISION=1
