+// Pulse patch: extra_node_ips must show up as additional host candidates next
+// to node_ip — gathered by a real peer connection, not just read back from
+// the rewrite rules.
+func Test_ExtraNodeIPsAdvertisedAsHostCandidates(t *testing.T) {
+	conf := &RTCConfig{
+		NodeIP:       NodeIP{V4: "203.0.113.7"},
+		ExtraNodeIPs: []string{"192.0.2.10", "203.0.113.7", "not-an-ip"},
+		// Set as in Pulse's configs: must not let local addresses through in
+		// the node_ip path (see NewWebRTCConfig).
+		AdvertiseInternalIP: true,
+	}
+	wc, err := NewWebRTCConfig(conf, false)
+	require.NoError(t, err)
+
+	api := webrtc.NewAPI(webrtc.WithSettingEngine(wc.SettingEngine))
+	pc, err := api.NewPeerConnection(wc.Configuration)
+	require.NoError(t, err)
+	defer pc.Close()
+
+	_, err = pc.CreateDataChannel("probe", nil)
+	require.NoError(t, err)
+	offer, err := pc.CreateOffer(nil)
+	require.NoError(t, err)
+	done := webrtc.GatheringCompletePromise(pc)
+	require.NoError(t, pc.SetLocalDescription(offer))
+	<-done
+
+	hosts := map[string]int{}
+	for _, line := range strings.Split(pc.LocalDescription().SDP, "\n") {
+		if !strings.HasPrefix(line, "a=candidate:") || !strings.Contains(line, " typ host") {
+			continue
+		}
+		fields := strings.Fields(line)
+		// IPv4 only: node_ip carries no IPv6 here, so local IPv6 addresses pass
+		// through unchanged, exactly as without the patch.
+		if len(fields) > 4 && strings.EqualFold(fields[2], "udp") && net.ParseIP(fields[4]).To4() != nil {
+			hosts[fields[4]]++
+		}
+	}
+	require.Contains(t, hosts, "203.0.113.7")
+	require.Contains(t, hosts, "192.0.2.10")
+	// The duplicate entry adds no second rule, so each local socket yields the
+	// two addresses once.
+	require.Equal(t, hosts["203.0.113.7"], hosts["192.0.2.10"])
+	for ip := range hosts {
+		require.Contains(t, []string{"203.0.113.7", "192.0.2.10"}, ip, "local address leaked: %s", ip)
+	}
+}
+
+// Without extra_node_ips nothing changes: node_ip alone replaces the local
+// addresses.
+func Test_NodeIPAloneUnchanged(t *testing.T) {
+	ips := nodeIPsWithExtras(&RTCConfig{NodeIP: NodeIP{V4: "203.0.113.7"}})
+	require.Equal(t, []string{"203.0.113.7"}, ips)
+}
