+// nodeIPsWithExtras returns node_ip followed by extra_node_ips, without
+// duplicates (Pulse patch). Each extra must be a bare IP address: a
+// "external/local" pair would turn into a pinned rule that shadows the
+// catch-all, which is not what extra_node_ips promises.
+func nodeIPsWithExtras(rtcConf *RTCConfig) []string {
+	ips := rtcConf.NodeIP.ToStringSlice()
+	seen := make(map[string]bool, len(ips)+len(rtcConf.ExtraNodeIPs))
+	for _, ip := range ips {
+		seen[ip] = true
+	}
+	for _, raw := range rtcConf.ExtraNodeIPs {
+		ip := net.ParseIP(strings.TrimSpace(raw))
+		if ip == nil {
+			logger.Warnw("ignoring invalid extra_node_ips entry", nil, "entry", raw)
+			continue
+		}
+		if s := ip.String(); !seen[s] {
+			seen[s] = true
+			ips = append(ips, s)
+		}
+	}
+	return ips
+}
