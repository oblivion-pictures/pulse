# Add this block to the existing ~/caddy/Caddyfile on the VPS, then reload:
#
#   cp ~/caddy/Caddyfile ~/caddy/Caddyfile.bak.$(date +%s)
#   $EDITOR ~/caddy/Caddyfile        # paste the block below
#   docker network connect pulse-net caddy 2>/dev/null || true   # idempotent
#   docker exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# Editing tip: when you change the Caddyfile, *overwrite* the file in place
# (`cat new > ~/caddy/Caddyfile` or `$EDITOR`), don't `sed -i`. The latter
# does an atomic-rename and the Caddy container keeps seeing the old inode
# until a `docker restart caddy`.
#
# The pulse_web nginx container handles all of /, /api/*, /whep/*, /hls/* and
# /livekit/* itself — Caddy just terminates TLS and forwards everything.
#
# Caddy needs to be on Pulse's docker network (`pulse-net`) so it can resolve
# `pulse_web` by container name. pulse_web binds 8100 to 127.0.0.1 only
# (Docker's DNAT bypasses UFW, so `0.0.0.0:8100` would be publicly reachable
# even when `ufw status` says it's blocked), so the older
# `host.docker.internal:8100` upstream no longer works for a containerised
# Caddy.
#
# Alternative if Caddy runs as a *host* process (not a container): use
# `reverse_proxy 127.0.0.1:8100` and skip the `docker network connect` step.

howispulse.com {
	reverse_proxy pulse_web:80 {
		header_up X-Forwarded-For {remote_host}
	}
}

# --- Steuerungs-Relay (②a) ---
# GANZ OBEN in die Live-Caddyfile (globaler Options-Block, nur einmal):
#
#   {
#       on_demand_tls {
#           ask http://auth:8000/selfhost/relay/tls-check
#       }
#   }
#
# Dann dieser Site-Block (Caddy holt das Cert pro Subdomain on-demand, NUR wenn
# /selfhost/relay/tls-check 200 liefert — sonst kein Cert):

*.relay.howispulse.com {
	tls {
		on_demand
	}
	reverse_proxy frps:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

# --- Token-Schwärzung im FEHLERprotokoll (Security-Audit 2026-11-05, S-T5) ---
# Browser-WebSockets können keine Header setzen → das Login-Token reist in der
# URL (?token=…). Das pulse_web-nginx loggt bereits query-frei (pulse_noquery),
# aber Caddys FEHLER-Log (Proxy-Dial-Fehler, z. B. während Deploys) druckte die
# volle URI inklusive Token (live gesehen 2026-11-05). Der eingebaute
# Query-Filter (Caddy ≥ 2.5) löscht den Parameter vor dem Schreiben — für den
# FEHLER-Log-Eintrag der das auslöste, mit Beweis: /ws?x=1 statt ?token=…&x=1.
# In denselben globalen Options-Block wie on_demand_tls oben, z. B. darunter:
#
#       log {
#           format filter {
#               wrap json
#               fields {
#                   request>uri query {
#                       delete token
#                   }
#               }
#           }
#       }

# --- Self-Host-allinone-Registry ---
# VOR dem ersten `caddy reload` einen DNS-A-Record
# registry.howispulse.com → <IP des VPS> anlegen, sonst schlägt ACME fehl.
# Caddy terminiert nur TLS und proxyt an den registry:2.8.3-Container auf
# pulse-net — die Token-Auth läuft INSIDE der Registry (auth.token.realm →
# auth-svc /registry/token), Caddy macht reines Passthrough.
registry.howispulse.com {
	reverse_proxy registry:5000 {
		header_up X-Forwarded-For {remote_host}
	}
}
