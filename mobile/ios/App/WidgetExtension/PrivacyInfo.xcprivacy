<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Privacy-Manifest der Widget-Erweiterung (App-Store-Pflicht für jedes
	     Bündel, das eine Pflicht-API nutzt). Sie trackt niemanden und sammelt
	     nichts; sie LIEST nur die Zahl für das Widget „Ungelesen" aus den
	     UserDefaults der App Group (`Gemeinsam/UngelesenAblage.swift`) —
	     Kategorie 1C8F.1, nur App und eigene Erweiterungen. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
