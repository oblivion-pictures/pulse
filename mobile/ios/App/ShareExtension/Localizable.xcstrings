      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld not included: files up to %lld MB, at most %lld items."
          }
        }
      }
    },
    "Abbrechen": {
      "comment": "Teilen-Erweiterung",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "An Pulse übergeben": {
      "comment": "Teilen-Erweiterung",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed over to Pulse"
          }
        }
      }
    },
    "Das Laden hat zu lange gedauert. Versuche es noch einmal.": {
      "comment": "Teilen-Erweiterung",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading took too long. Please try again."
          }
        }
      }
    },
