<?xml version="1.0" encoding="utf-8"?>
<!-- Statusleisten-Symbol für Push- und Anruf-Meldungen: das Pulse-Zeichen
     (Logo/files/pulse-mark-white.svg) als weiße Silhouette auf transparentem
     Grund. Android färbt es selbst ein und wertet nur den Alphakanal aus —
     die gestaffelte Deckkraft der Ringe bleibt sichtbar. Ringe gegenüber dem
     Logo verdickt, sonst verschwinden sie bei 24 dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- äußerer Ring -->
    <path
        android:pathData="M2.4,12a9.6,9.6 0,1 0,19.2 0a9.6,9.6 0,1 0,-19.2 0"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.4"
        android:strokeWidth="1.3" />
    <!-- mittlerer Ring -->
    <path
        android:pathData="M5.45,12a6.55,6.55 0,1 0,13.1 0a6.55,6.55 0,1 0,-13.1 0"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.7"
        android:strokeWidth="1.5" />
    <!-- innerer Ring -->
    <path
        android:pathData="M8.55,12a3.45,3.45 0,1 0,6.9 0a3.45,3.45 0,1 0,-6.9 0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6" />
    <!-- Mittelpunkt -->
    <path
        android:pathData="M10.5,12a1.5,1.5 0,1 0,3 0a1.5,1.5 0,1 0,-3 0z"
        android:fillColor="#FFFFFFFF" />
</vector>
