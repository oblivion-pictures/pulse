+    jetzt: Instant,
+    sperre: Duration,
+    hoechstalter: Duration,
+) -> PulseSchritt {
+    let Some(a) = anfrage else {
+        return PulseSchritt::Anfordern;
+    };
+    if !hoechstalter.is_zero() && jetzt.duration_since(a.erste) >= hoechstalter {
+        PulseSchritt::Aufgeben
+    } else if jetzt.duration_since(a.letzte) >= sperre {
+        PulseSchritt::Anfordern
+    } else {
+        PulseSchritt::Warten
+    }
+}
