+        assert_eq!(pulse_schritt(Some(&a), t0 + ms(40), ms(20), ms(100)), PulseSchritt::Anfordern);
+        // Sperre 0: jede Runde erneut, wie ohne Patch.
+        assert_eq!(pulse_schritt(Some(&a), t0 + ms(21), ms(0), ms(100)), PulseSchritt::Anfordern);
+    }
+
+    #[test]
+    fn pulse_hoechstalter_misst_ab_der_ersten_anforderung() {
+        let t0 = Instant::now();
+        let ms = Duration::from_millis;
+        // Zuerst bei 0, zuletzt bei 70 angefordert: bei 99 ist die Sperre um,
+        // bei 100 das Hoechstalter — gezaehlt ab der ERSTEN Anforderung, die
+        // Wiederholung setzt es nicht zurueck.
+        let a = anfrage(t0, t0 + ms(70));
+        assert_eq!(pulse_schritt(Some(&a), t0 + ms(99), ms(20), ms(100)), PulseSchritt::Anfordern);
+        assert_eq!(pulse_schritt(Some(&a), t0 + ms(100), ms(20), ms(100)), PulseSchritt::Aufgeben);
+        // Hoechstalter 0: keine Grenze.
+        assert_eq!(
+            pulse_schritt(Some(&a), t0 + Duration::from_secs(20), ms(20), ms(0)),
+            PulseSchritt::Anfordern
+        );
+    }
+}
